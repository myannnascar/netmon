#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

LAN_NETWORKS=""
LAN_IFACES=""

append_lan_network() {
	local network="$1"
	[ -n "$network" ] || return

	case " $LAN_NETWORKS " in
		*" $network "*) ;;
		*) LAN_NETWORKS="$LAN_NETWORKS $network" ;;
	esac
}

append_lan_iface() {
	local iface="$1"
	[ -n "$iface" ] || return

	case "$iface" in
		*@*) iface="${iface##*@}" ;;
	esac

	case " $LAN_IFACES " in
		*" $iface "*) ;;
		*) LAN_IFACES="$LAN_IFACES $iface" ;;
	esac
}

collect_lan_zone() {
	local section="$1"
	local name network networks devices device

	config_get name "$section" name
	[ "$name" = "lan" ] || return

	config_get networks "$section" network
	for network in $networks; do
		append_lan_network "$network"
	done
	config_list_foreach "$section" network append_lan_network

	config_get devices "$section" device
	for device in $devices; do
		append_lan_iface "$device"
	done
	config_list_foreach "$section" device append_lan_iface
}

collect_lan_iface() {
	local network="$1"
	local device ifname iface type

	config_get type "$network" type
	[ "$type" = "bridge" ] && append_lan_iface "br-$network"

	config_get device "$network" device
	append_lan_iface "$device"

	config_get ifname "$network" ifname
	for iface in $ifname; do
		append_lan_iface "$iface"
	done
}

detect_lan_ifaces() {
	local network iface

	LAN_NETWORKS=""
	LAN_IFACES=""

	config_load firewall
	config_foreach collect_lan_zone zone

	[ -n "$LAN_NETWORKS" ] || LAN_NETWORKS=" lan"

	config_load network
	for network in $LAN_NETWORKS; do
		collect_lan_iface "$network"
	done

	[ -n "$LAN_IFACES" ] || LAN_IFACES=" br-lan"
}

format_ifaces() {
	local ifaces="$1"
	local iface out

	for iface in $ifaces; do
		out="${out:+$out, }\"$iface\""
	done

	printf '%s' "$out"
}

chain_suffix() {
	printf '%s' "$1" | sed 's/[^A-Za-z0-9_]/_/g'
}

append_lan_ingress_chains() {
	local iface suffix

	for iface in $LAN_IFACES; do
		suffix="$(chain_suffix "$iface")"
		ingress_chains="$ingress_chains

    chain ingress_lan_$suffix {
        type filter hook ingress device \"$iface\" priority 0; policy accept;
        ip saddr != 0.0.0.0 update @v4_up { ip saddr counter }
        ip6 saddr != :: ip6 saddr != fe80::/10 ip6 saddr != ff00::/8 update @v6_up { ip6 saddr counter }
    }"
	done
}

generate_nft_rules() {
    local lan_ifaces ingress_chains prerouting_rules

    detect_lan_ifaces
    lan_ifaces="$(format_ifaces "$LAN_IFACES")"

    if [ "$1" != "0" ]; then
        append_lan_ingress_chains
    else
        prerouting_rules="
        iifname { $lan_ifaces } ip saddr != 0.0.0.0 update @v4_up { ip saddr counter }
        iifname { $lan_ifaces } ip6 saddr != :: ip6 saddr != fe80::/10 ip6 saddr != ff00::/8 update @v6_up { ip6 saddr counter }"
    fi

    cat <<EOF > /tmp/netmon.nft
table inet netmon {
    set v4_up { type ipv4_addr; flags dynamic, timeout; timeout 1h; size 1024; counter; }
    set v4_down { type ipv4_addr; flags dynamic, timeout; timeout 1h; size 1024; counter; }
    set v6_up { type ipv6_addr; flags dynamic, timeout; timeout 1h; size 1024; counter; }
    set v6_down { type ipv6_addr; flags dynamic, timeout; timeout 1h; size 1024; counter; }

    chain prerouting {
        type filter hook prerouting priority raw; policy accept;
        $prerouting_rules
    }

    chain postrouting {
        type filter hook postrouting priority 0; policy accept;
        oifname { $lan_ifaces } ip daddr != 0.0.0.0 ip daddr != 255.255.255.255 ip daddr != 224.0.0.0/4 update @v4_down { ip daddr counter }
        oifname { $lan_ifaces } ip6 daddr != :: ip6 daddr != fe80::/10 ip6 daddr != ff00::/8 update @v6_down { ip6 daddr counter }
    }$ingress_chains
}
EOF
}

DB_FILE="/etc/netmon/netmon.db"

start_service() {
	config_load netmon
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 0 ] && return

	[ -d "/etc/netmon" ] || mkdir -p /etc/netmon
	
	sed -i '/netmon do_snapshot/d' /etc/crontabs/root 2>/dev/null
	/etc/init.d/cron restart

	generate_nft_rules 1
	/usr/sbin/nft delete table inet netmon 2>/dev/null
	if ! /usr/sbin/nft -c -f /tmp/netmon.nft; then
		logger -t netmon "failed to validate nft ingress rules, retrying without ingress"
		generate_nft_rules 0
		/usr/sbin/nft delete table inet netmon 2>/dev/null
		if ! /usr/sbin/nft -c -f /tmp/netmon.nft; then
			logger -t netmon "failed to validate nft rules"
			return 1
		fi
	fi
	if ! /usr/sbin/nft -f /tmp/netmon.nft; then
		logger -t netmon "failed to load nft rules"
		return 1
	fi
	
	procd_open_instance
	procd_set_param command /usr/bin/netmon
	procd_set_param respawn
	procd_set_param term_timeout 10
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	sed -i '/netmon do_snapshot/d' /etc/crontabs/root 2>/dev/null
	/etc/init.d/cron restart
}

service_triggers() {
	procd_add_reload_trigger "netmon"
	procd_add_reload_trigger "network"
	procd_add_reload_trigger "firewall"
}
